[Unit]
Description=certservers certificate management service
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=certservers
Group=certservers
RuntimeDirectory=certservers
RuntimeDirectoryMode=0750
ExecStart=/usr/sbin/certservers --config /etc/certservers/certservers.toml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/certservers /run/certservers
UMask=0027

[Install]
WantedBy=multi-user.target
